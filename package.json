{
  "name": "@wemotion/auth-i18n",
  "version": "0.1.0",
  "description": "Zentraler i18n-Katalog (Deutsch, du/Moin) fuer Ory Kratos UI-Meldungen, gekeyt nach stabiler Message-ID. Einbinden ueberall, wo Kratos-Flows gerendert werden.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales/de.json": "./locales/de.json",
    "./locales/en.json": "./locales/en.json",
    "./ui/de.json": "./locales/ui.de.json",
    "./app-copy/de.json": "./locales/app-copy.de.json"
  },
  "files": [
    "src",
    "locales",
    "courier-templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "sideEffects": false,
  "license": "UNLICENSED",
  "private": true
}
